<div class="standard-form">
  <p class="notes">Editing tags for <strong>{{documentName}}</strong></p>
  {{#if showInheritedLine}}
    <p class="notes handy-dandy-tag-inherited-line">Shown from the playlist: {{#each inheritedPlaylistTags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
  {{/if}}
  <ul class="tag-list">
    {{#each tags}}
      <li data-tag="{{tag}}">
        {{#if isRenaming}}
          <div class="tag-rename-row">
            <input type="text" name="renameTag-{{tag}}" value="{{tag}}" autocomplete="off" />
            <button type="button" data-action="saveRename" data-tag="{{tag}}">
              <i class="fa-solid fa-check"></i> Save
            </button>
            <button type="button" data-action="cancelRename">
              Cancel
            </button>
          </div>
        {{else}}
          <span class="handy-dandy-tag">{{tag}}</span>
          <span class="tag-row-actions">
            <button type="button" data-action="removeTag" data-tag="{{tag}}">
              <i class="fa-solid fa-times"></i> Remove
            </button>
            <button type="button" data-action="startRename" data-tag="{{tag}}">
              <i class="fa-solid fa-pen"></i> Rename
            </button>
            <button type="button" class="{{#if pendingDeleteConfirm}}handy-dandy-tag-delete-confirm{{/if}}" data-action="deleteEverywhere" data-tag="{{tag}}">
              {{#if pendingDeleteConfirm}}
                Confirm delete everywhere
              {{else}}
                <i class="fa-solid fa-trash"></i> Delete everywhere
              {{/if}}
            </button>
          </span>
        {{/if}}
      </li>
    {{/each}}
  </ul>
  <div class="tag-add-row form-group">
    <input type="text" name="newTag" placeholder="New tag" autocomplete="off" />
    <button type="button" data-action="addTag">
      <i class="fa-solid fa-plus"></i> Add
    </button>
  </div>
</div>
